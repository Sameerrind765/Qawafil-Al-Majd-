# Google Gemini AI API Key (Required for server-side intelligent features)
GEMINI_API_KEY=

# Public Application URL
APP_URL=http://localhost:3000

# OCR Space API Key (Optional fallback for invoice extraction)
OCR_SPACE_API_KEY=

# Cloudinary Storage Configuration (Optional for receipt image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Service Account JSON (Optional for server-side Firebase Admin verification)
FIREBASE_SERVICE_ACCOUNT_KEY=
